# Copy to .env and replace the values. Use a long random URL-safe database password.
PUBLIC_DOMAIN=rankings.example.org
POSTGRES_DB=smartkeys_community
POSTGRES_USER=smartkeys
POSTGRES_PASSWORD=replace-with-long-random-url-safe-secret
# Comma-separated Google Web OAuth client IDs. Leave empty until configured; backup returns 503.
GOOGLE_CLIENT_IDS=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_MAX_CLIENTS=10000
